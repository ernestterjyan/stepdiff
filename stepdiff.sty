% stepdiff v0.5.0
% Author: Ernest Terjyan
% Description: LuaLaTeX package for step-by-step derivations with visual diffing.
% License: MIT

% ---------------------------------------------------------------------------
% Package metadata
% ---------------------------------------------------------------------------
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{stepdiff}
  [2026/06/13 v0.5.0 Token-level diffs for step-by-step derivations]

% ---------------------------------------------------------------------------
% Required packages
% ---------------------------------------------------------------------------
\RequirePackage{amsmath}
\RequirePackage{xcolor}
\RequirePackage{xparse}

% ---------------------------------------------------------------------------
% User customization hooks
% ---------------------------------------------------------------------------
% Redefine these commands in the document preamble to change the visual style.
\providecommand{\SDchanged}[1]{%
  \begingroup
  \setlength{\fboxsep}{1pt}%
  \mathchoice
    {\hbox{\colorbox{yellow!25}{$\displaystyle #1$}}}%
    {\hbox{\colorbox{yellow!25}{$\textstyle #1$}}}%
    {\hbox{\colorbox{yellow!25}{$\scriptstyle #1$}}}%
    {\hbox{\colorbox{yellow!25}{$\scriptscriptstyle #1$}}}%
  \endgroup
}
\providecommand{\SDreason}[1]{%
  \normalfont\scriptsize\itshape\color{black!55}#1%
}
\providecommand{\SDreasonsep}{\quad}
\newif\ifSDshowreasons
\SDshowreasonstrue
\providecommand{\SDhidereasons}{\SDshowreasonsfalse}
\providecommand{\SDshowreasons}{\SDshowreasonstrue}
\providecommand{\SDmaybereason}[1]{%
  \ifSDshowreasons
    \SDreasonsep\text{\SDreason{#1}}%
  \else
    {}%
  \fi
}

% ---------------------------------------------------------------------------
% Highlight modes
% ---------------------------------------------------------------------------
\newcommand{\SDhighlightbackground}{%
  \renewcommand{\SDchanged}[1]{%
    \begingroup
    \setlength{\fboxsep}{1pt}%
    \mathchoice
      {\hbox{\colorbox{yellow!25}{$\displaystyle ##1$}}}%
      {\hbox{\colorbox{yellow!25}{$\textstyle ##1$}}}%
      {\hbox{\colorbox{yellow!25}{$\scriptstyle ##1$}}}%
      {\hbox{\colorbox{yellow!25}{$\scriptscriptstyle ##1$}}}%
    \endgroup
  }%
}
\newcommand{\SDhighlightunderline}{%
  \renewcommand{\SDchanged}[1]{%
    \begingroup
    \underline{##1}%
    \endgroup
  }%
}
\newcommand{\SDhighlightcolor}{%
  \renewcommand{\SDchanged}[1]{%
    \begingroup
    \color{blue!60!black}%
    ##1%
    \endgroup
  }%
}
\newcommand{\SDhighlightnone}{%
  \renewcommand{\SDchanged}[1]{##1}%
}

% ---------------------------------------------------------------------------
% Themes
% ---------------------------------------------------------------------------
\newcommand{\SDthemesoft}{%
  \SDhighlightbackground
  \renewcommand{\SDreason}[1]{%
    \normalfont\scriptsize\itshape\color{black!55}##1%
  }%
}
\newcommand{\SDthememinimal}{%
  \SDhighlightunderline
  \renewcommand{\SDreason}[1]{%
    \normalfont\scriptsize\itshape\color{black!65}##1%
  }%
}

% ---------------------------------------------------------------------------
% Layout modes
% ---------------------------------------------------------------------------
\newcommand{\SDlayoutcompact}{%
  \setlength{\jot}{3pt}%
  \renewcommand{\SDreasonsep}{\quad}%
}
\newcommand{\SDlayoutlecture}{%
  \setlength{\jot}{6pt}%
  \renewcommand{\SDreasonsep}{\qquad}%
}
\newcommand{\SDlayoutwide}{%
  \setlength{\jot}{4pt}%
  \renewcommand{\SDreasonsep}{\hspace{3em}}%
}

% ---------------------------------------------------------------------------
% Legacy style aliases
% ---------------------------------------------------------------------------
\newcommand{\SDstylehighlight}{\SDhighlightbackground}
\newcommand{\SDstyleunderline}{\SDhighlightunderline}

% ---------------------------------------------------------------------------
% Lua loading
% ---------------------------------------------------------------------------
\directlua{stepdiff = require("stepdiff")}

% ---------------------------------------------------------------------------
% expl3 keys
% ---------------------------------------------------------------------------
\ExplSyntaxOn

\tl_new:N \l__stepdiff_reason_tl
\tl_new:N \l__stepdiff_diff_tl

\keys_define:nn { stepdiff / step }
  {
    reason .tl_set:N = \l__stepdiff_reason_tl,
    reason .initial:n = {},
    diff .tl_set:N = \l__stepdiff_diff_tl,
    diff .initial:n = auto
  }

\keys_define:nn { stepdiff / env }
  {
    theme .choice:,
    theme / soft .code:n = { \SDthemesoft },
    theme / minimal .code:n = { \SDthememinimal },
    layout .choice:,
    layout / compact .code:n = { \SDlayoutcompact },
    layout / lecture .code:n = { \SDlayoutlecture },
    layout / wide .code:n = { \SDlayoutwide },
    highlight .choice:,
    highlight / background .code:n = { \SDhighlightbackground },
    highlight / underline .code:n = { \SDhighlightunderline },
    highlight / color .code:n = { \SDhighlightcolor },
    highlight / none .code:n = { \SDhighlightnone },
    style .choice:,
    style / highlight .code:n = { \SDstylehighlight },
    style / underline .code:n = { \SDstyleunderline }
  }

% ---------------------------------------------------------------------------
% Environment definition
% ---------------------------------------------------------------------------
\NewDocumentEnvironment{stepdiff}{ O{} }
  {
    \group_begin:
      \SDlayoutcompact
      \keys_set:nn { stepdiff / env } { #1 }
      \directlua{stepdiff.begin()}
  }
  {
      \directlua{stepdiff.render()}
    \group_end:
  }

% ---------------------------------------------------------------------------
% \step definition
% ---------------------------------------------------------------------------
\NewDocumentCommand{\step}{ O{} m }
  {
    \group_begin:
      \tl_clear:N \l__stepdiff_reason_tl
      \tl_set:Nn \l__stepdiff_diff_tl { auto }
      \keys_set:nn { stepdiff / step } { #1 }
      \directlua{
        stepdiff.add(
          "\luaescapestring{\detokenize{#2}}",
          "\luaescapestring{\tl_use:N \l__stepdiff_reason_tl}",
          "\luaescapestring{\tl_use:N \l__stepdiff_diff_tl}"
        )
      }
    \group_end:
  }

\ExplSyntaxOff

\endinput
